# =============================================================================
# LAB ONLY - NOT FOR PRODUCTION. Rotate before any shared or real use.
#
# The passwords below are the documented demo credentials of this POC and
# MUST stay in sync with the DEFINE defaults in scripts/01-init-db.sql
# (the first-boot init script creates the schema users with them, and
# SQL files executed from /container-entrypoint-initdb.d cannot read env
# vars). They are intentionally identical to the Rakefile LAB DEFAULTS.
#
# Copy this file to .env (untracked) and change the values locally -
# remember to update scripts/01-init-db.sql if you do.
# =============================================================================
# Oracle container environment (no real secrets - copy to .env and fill)
#
# gvenzl/oracle-free supported vars:
ORACLE_PASSWORD=ChangeMe123!
ORACLE_DATABASE=PDB_OLTP
ORACLE_HTTP_PORT=8080
ORACLE_LISTENER_PORT=1521

# Application schema users created by scripts/01-init-db.sql.
# LOCAL LAB ONLY: values must match the DEFINE defaults in that script.
APP_OWNER_USER=APP_OWNER
APP_OWNER_PWD=LabOwnerPass1
APP_RUNTIME_USER=APP_RUNTIME
APP_RUNTIME_PWD=LabRuntimePass1
APP_REPORTING_USER=APP_REPORTING
APP_REPORTING_PWD=LabReportPass1
